<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="207.0" prefWidth="460.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.finalprojectadprog.PrimaryController">
   <children>
      <Label fx:id="welcApp" text="Welcom to the App" textFill="#5f87d7">
         <font>
            <Font size="27.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" prefHeight="86.0" prefWidth="420.0" spacing="7.0">
         <children>
            <Label fx:id="Name" text="Username" />
            <TextField fx:id="nameInput" alignment="CENTER" prefHeight="26.0" prefWidth="114.0" />
            <Label fx:id="ID" text="ID" />
            <TextField fx:id="IDinput" />
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="80.0" prefWidth="420.0" spacing="7.0">
         <children>
            <Label fx:id="pass" alignment="CENTER" text="Password" />
            <TextField fx:id="passInput" />
         </children>
      </HBox>
      <Button fx:id="LoginButton" onAction="#switchToSecondary" text="Login" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
