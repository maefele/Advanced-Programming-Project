<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox alignment="TOP_CENTER" prefHeight="207.0" prefWidth="460.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.finalprojectadprog.ViewStudentController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Registered Students List" textFill="#342dbe">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TableView fx:id="studentTable" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="75.0" text="Student ID" />
          <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Student Name" />
            <TableColumn fx:id="gradeColumn" prefWidth="75.0" text="Grades" />
        </columns>
      </TableView>
      <Button mnemonicParsing="false" onAction="#goToDashboard" text="Back to Dashboard" />
   </children>
</VBox>
