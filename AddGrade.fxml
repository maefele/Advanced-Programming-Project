<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="207.0" prefWidth="460.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.finalprojectadprog.AddGrade">
    <children>
        <Label prefHeight="19.0" prefWidth="118.0" text="Add student grade">
         <font>
            <Font size="13.0" />
         </font></Label>
      <VBox prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label contentDisplay="RIGHT" text="Enter StudentID        ">
               <graphic>
                  <TextField fx:id="idInput" />
               </graphic>
            </Label>
            <Label contentDisplay="RIGHT" text="Enter student grade ">
               <graphic>
                  <TextField fx:id="grade" />
               </graphic>
            </Label>
         </children>
      </VBox>
      <VBox alignment="CENTER_RIGHT" prefHeight="0.0" prefWidth="420.0">
         <children>
              <Button fx:id="secondaryButton" alignment="CENTER" contentDisplay="TOP" onAction="#switchToPrimary" prefHeight="26.0" prefWidth="90.0" text="Main Menu" textAlignment="CENTER" />
         </children>
      </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
