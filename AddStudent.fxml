<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="207.0" prefWidth="460.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.finalprojectadprog.AddStudent">
   <children>
      <Label text="Add student">
         <font>
            <Font size="19.0" />
         </font></Label>
      <VBox prefWidth="460.0" spacing="15.0">
         <children>
            <Label contentDisplay="RIGHT" text="StudentName">
               <graphic>
                  <TextField fx:id="nameInput" />
               </graphic>
            </Label>
            <Label contentDisplay="RIGHT" text="StudentID      ">
               <graphic>
                  <TextField fx:id="idInput" layoutY="4.0" prefHeight="30.0" prefWidth="150.0" promptText="44XXXXXXX" />
               </graphic>
            </Label>
         </children>
      </VBox>
      <VBox alignment="BOTTOM_RIGHT" prefHeight="28.0" prefWidth="420.0">
         <children>
            <Button fx:id="primaryButton" alignment="CENTER" onAction="#switchToSecondary" prefHeight="26.0" prefWidth="90.0" text="Next" textAlignment="CENTER" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
