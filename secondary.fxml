<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="207.0" prefWidth="460.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.finalprojectadprog.SecondaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Student Management System - Dashboard" textFill="#3447c7">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button mnemonicParsing="false" onAction="#goToAddStudent" text="Add New Student" />
      <Button mnemonicParsing="false" onAction="#goToAddGrade" text="Add Student Grades" />
      <Button mnemonicParsing="false" onAction="#goToViewStudents" text="View All Students" />
      <Button mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
   </children>
</VBox>
